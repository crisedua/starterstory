PORT=4000

# Supabase (obligatorio)
# El backend usa el SERVICE_ROLE para escrituras (saltarse RLS).
# El frontend usa el ANON_KEY.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...
SUPABASE_ANON_KEY=eyJhbGci...

# Estas también pueden cargarse desde la UI (tabla app_settings).
APIFY_TOKEN=
OPENAI_API_KEY=
# Modelo OpenAI a usar (default: gpt-5.4-mini). Cambia sin redeploy.
OPENAI_MODEL=gpt-5.4-mini
